        public static string name (int index) {
            return index >= 0 && index < NAMES.length ? NAMES[index] : "";
        }

        private static Gee.HashMap<string, int>? by_name;

        public static int index_of (string name) {
            if (by_name == null) {
                by_name = new Gee.HashMap<string, int> ();
                for (int i = 0; i < NAMES.length; i++) if (NAMES[i] != "") by_name[NAMES[i]] = i;
            }
            return by_name.has_key (name) ? by_name[name] : -1;
        }

        public static int arity (int index) {
            return index >= 0 && index < ARITY.length ? ARITY[index] : -1;
        }
